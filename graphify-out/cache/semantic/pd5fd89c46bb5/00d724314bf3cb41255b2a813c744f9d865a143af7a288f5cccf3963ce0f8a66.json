{"nodes": [{"id": "docs_fundamentals_cqrsfundamentals", "label": "CQRS Fundamentals (guide)", "file_type": "document", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_cqrs", "label": "CQRS (Command Query Responsibility Segregation)", "file_type": "rationale", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes need rich rule-enforcing models; reads need flat fast shapes. Separating them resolves model conflict, workload asymmetry and growing complexity, but moves complexity rather than removing it."}, {"id": "docs_fundamentals_cqrsfundamentals_greg_young", "label": "Greg Young", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_cqs", "label": "Command-Query Separation (CQS)", "file_type": "rationale", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_bertrand_meyer", "label": "Bertrand Meyer", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_command", "label": "Command", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_query", "label": "Query", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_event", "label": "Event (message)", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_bounded_context", "label": "Bounded Context", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L190", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apply CQRS per bounded context only where benefits are visible; mixing with plain CRUD is healthy."}, {"id": "docs_fundamentals_cqrsfundamentals_write_side", "label": "Write Side (command handlers, aggregates)", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_aggregate", "label": "Aggregate", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L230", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_read_side", "label": "Read Side (query handlers)", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L241", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_read_model", "label": "Read Model / Projection", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L247", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_dispatcher", "label": "Dispatcher / Command & Query Bus", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L281", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional convenience: decouples callers from handlers and hosts cross-cutting behaviors; direct handler calls are still CQRS."}, {"id": "docs_fundamentals_cqrsfundamentals_pipeline_behaviors", "label": "Pipeline Behaviors (logging, validation, authorization, transaction)", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L297", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_result_pattern", "label": "Result Pattern", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L341", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_single_database_variant", "label": "Single Database, Separated Models", "file_type": "rationale", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L364", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strongly consistent, low operational cost, most of the benefit; often the right final destination."}, {"id": "docs_fundamentals_cqrsfundamentals_separate_stores", "label": "Separate Read and Write Stores", "file_type": "rationale", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L397", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent scaling and specialized storage at the cost of eventual consistency, projection code and rebuilds; synchronous dual write discouraged."}, {"id": "docs_fundamentals_cqrsfundamentals_eventual_consistency", "label": "Eventual Consistency", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L437", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_domain_events", "label": "Domain Events", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L476", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_integration_events", "label": "Integration Events", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L485", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_event_sourcing", "label": "Event Sourcing", "file_type": "rationale", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L517", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent of CQRS; adopt only when auditability or temporal queries are genuinely required due to schema evolution, replay and privacy costs."}, {"id": "docs_fundamentals_cqrsfundamentals_snapshot", "label": "Snapshot", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L554", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_projector", "label": "Projector and Read Model Rebuilding", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L562", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_dual_write_problem", "label": "Dual-Write Problem", "file_type": "concept", "source_file": "docs/fundamentals/CqrsFundamentals.md", "source_location": "L603", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fundamentals_cqrsfundamentals_outbox_pattern", "label": "Outbox Pattern", "file_type":